# ====================================
# VARIÁVEIS DE AMBIENTE - PRODUÇÃO
# ====================================

# ==================
# BACKEND (Railway)
# ==================

# Django
DJANGO_SETTINGS_MODULE=backend.settings.production
SECRET_KEY=sua-chave-secreta-super-segura-aqui-minimo-50-caracteres
DEBUG=False

# Database (Railway fornece automaticamente)
# DATABASE_URL=postgresql://user:password@host:port/dbname

# Hosts e CORS
ALLOWED_HOSTS=seu-app.up.railway.app,*.railway.app
CORS_ALLOWED_ORIGINS=https://seu-frontend.vercel.app,https://seu-dominio.com
CSRF_TRUSTED_ORIGINS=https://seu-frontend.vercel.app,https://seu-dominio.com

# Security (em produção com HTTPS)
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# ====================
# FRONTEND (Vercel)
# ====================

# API Base URL (usar URL do Railway após deploy)
VITE_API_BASE_URL=https://seu-backend.up.railway.app/api
