# Fly.io Environment Variables
# Copy this file and configure your secrets in Fly.io

# Django Settings
SECRET_KEY=your-secret-key-here-generate-a-new-one
DEBUG=False
DJANGO_SETTINGS_MODULE=backend.settings.production

# Allowed Hosts (add your fly.io domain)
ALLOWED_HOSTS=desafio-extrator-backend.fly.dev,localhost

# CORS Origins (add your frontend domain)
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173

# CSRF Trusted Origins
CSRF_TRUSTED_ORIGINS=https://your-frontend.vercel.app,https://desafio-extrator-backend.fly.dev

# Database (Fly.io PostgreSQL)
DATABASE_URL=postgres://user:password@hostname:5432/dbname

# Email Configuration (Gmail SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com

# Security Settings
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# Port (Fly.io sets this automatically)
PORT=8000
